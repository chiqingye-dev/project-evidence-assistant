  "tasks": [
    {
      "id": "M2-S01",
      "goal": "chapter_outline",
      "request": "从后端目录打开提交主题，生成可定位的章结构，先不写整章正文。",
      "required": [
        "提交章包含入口/参数身份、校验/幂等、事务写入/响应三个阅读方面；小节能定位获准代码。",
        "POST /api/v1/problems/{slug}/submissions，身份来自AuthenticationPrincipal而非客户端userId；accepted为声明。",
        "目录线索不当事实，回调/注解不当已运行幂等/原子事务/消息或判题证明；保留未读实现。"
      ]
    },
    {
      "id": "M2-S02",
      "goal": "section_explanation",
      "request": "选择入口/参数或校验小节，说明身份、输入、校验先后、幂等线索和响应。",
      "required": [
        "组合POST完整URL，Idempotency-Key请求头、language/sourceCode正文、principal.userId进入回调create；未读coalescer不虚构并发机制。",
        "Service先解析UUID、验证language/source、查活跃账号，再查旧幂等结果；命中可返回旧结果，DuplicateKeyException后再查同用户/请求结果。",
        "只接受JAVA_21；source校验非空/非blank、无NUL、UTF-8字节最多65536，并对codeOnly做package/public Main匹配；不把字节数说成字符数，不凭静态正则说编译或安全运行已成功。",
        "UUID校验包括canonical spelling的equalsIgnoreCase比较；未读全方法则明确相应缺口，不编造跳过校验或同键payload比对。",
        "202 accepted表示入口声明接受请求，不等于判题完成；每段事实依据来自本任务读到且支持对应内容的文件。"
      ]
    },
    {
      "id": "M2-S03",
      "goal": "section_explanation",
      "request": "选择事务写入小节，说明配额/幂等复查、冻结版本、三类写入及响应边界。",
      "required": [
        "createNew带@Transactional，调用requireCurrentWrite、lockQuota并复查active、旧幂等；缺quota行抛IllegalStateException，>=3抛TOO_MANY_REQUESTS，题目版本缺失NOT_FOUND。注解不证明运行事务生效。",
        "Mapper lockQuota声明user_judge_quota_lock按userId FOR UPDATE；队列数是submission QUEUED/RETRYING加content_validation_job QUEUED加self_test_job QUEUED，不只数submission。",
        "公开ACTIVE题目slug筛选取得current judge version及资源/镜像/数据集快照；不要说请求输入自己决定冻结版本。",
        "enqueue按顺序insertSubmission、insertJudgeTask、insertOutboxEvent；insert SQL保存初始QUEUED/NULL verdict/statusVersion0，outbox事件为JUDGE_TASK_QUEUED、契约1。",
        "taskPayload包含taskId、submissionId、JUDGE_SUBMISSION、contractVersion1，返回SubmissionResult(提交id,QUEUED,0)。outbox插入不等于MQ已经发布/消费或判题完成。",
        "跨文件事实分别引用实际声明/调用；未知account/coalescer/限流/afterCommit实现及数据库运行保证保留缺口。"
      ]
    }
  ],
